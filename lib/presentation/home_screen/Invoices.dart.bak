                                                                              .info_outline,
                                                                          color: ColorConstant
                                                                              .maingreen,
                                                                          size:
                                                                              28),
                                                                      SizedBox(
                                                                          width:
                                                                              8),
                                                                      Text(
                                                                        "${AppLocalizations.of(context)!.detail}- $flag",
                                                                        style:
                                                                            TextStyle(
                                                                          fontWeight:
                                                                              FontWeight.bold,
                                                                          fontSize:
                                                                              Adaptive.sp(19),
                                                                          color:
                                                                              ColorConstant.maingreen,
                                                                        ),
                                                                      ),
                                                                    ],
                                                                  ),
                                                                  content:
                                                                      SingleChildScrollView(
                                                                    child:
                                                                        Table(
                                                                      columnWidths: const {
                                                                        0: IntrinsicColumnWidth(),
                                                                        1: FlexColumnWidth(),
                                                                      },
                                                                      defaultVerticalAlignment:
                                                                          TableCellVerticalAlignment
                                                                              .middle,
                                                                      children: [
                                                                        _richTableRow(
                                                                            Icons.shopping_bag,
                                                                            AppLocalizations.of(context)!.msgCommodityy,
                                                                            commodity),
                                                                        _richTableRow(
                                                                            Icons.confirmation_number,
                                                                            AppLocalizations.of(context)!.dealId,
                                                                            dealId),
                                                                        _richTableRow(
                                                                            Icons.location_on,
                                                                            AppLocalizations.of(context)!.msgDistrict,
                                                                            district),
                                                                        _richTableRow(
                                                                            Icons.calendar_today,
                                                                            AppLocalizations.of(context)!.msgDate,
                                                                            date),
                                                                        _richTableRow(
                                                                            Icons
                                                                                .inventory_2,
                                                                            "${AppLocalizations.of(context)!.quantityLabel}:",
                                                                            quantity.isNotEmpty
                                                                                ? "$quantity ${AppLocalizations.of(context)!.perQntl}"
                                                                                : "N/A"),
                                                                        _richTableRow(
                                                                            Icons
                                                                                .currency_rupee,
                                                                            AppLocalizations.of(context)!
                                                                                .price,
                                                                            price.isNotEmpty
                                                                                ? "$price ${AppLocalizations.of(context)!.perQtl}"
                                                                                : "N/A"),
                                                                        _richTableRow(
                                                                            Icons.category,
                                                                            AppLocalizations.of(context)!.typeLabel,
                                                                            flag),
                                                                        if (warehouse
                                                                            .isNotEmpty)
                                                                          _richTableRow(
                                                                              Icons.home_work,
                                                                              AppLocalizations.of(context)!.msgWarehouse,
                                                                              warehouse),
                                                                        if (name
                                                                            .isNotEmpty)
                                                                          _richTableRow(
                                                                              Icons.person,
                                                                              AppLocalizations.of(context)!.msgName,
                                                                              name),
                                                                      ],
                                                                    ),
                                                                  ),
                                                                  actions: [
                                                                    TextButton(
                                                                      onPressed:
                                                                          () =>
                                                                              Navigator.of(ctx).pop(),
                                                                      child:
