                                                                        "Close",
                                                                        style:
                                                                            TextStyle(
                                                                          color:
                                                                              ColorConstant.maingreen,
                                                                          fontSize:
                                                                              Adaptive.sp(16),
                                                                          fontWeight:
                                                                              FontWeight.bold,
                                                                        ),
                                                                      ),
                                                                    ),
                                                                  ],
                                                                ),
                                                              );
                                                            },
                                                            child: Text(
