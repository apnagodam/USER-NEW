                                                simpleButton(
                                                    text: AppLocalizations.of(
                                                            context)!
                                                        .msgLoging,
                                                    callback: () {
                                                      showLoginBottomsheet(
                                                          context);
                                                    }),
                                              ],
                                            ),
                                          ),
                                        )
                                      : (() {
                                          final filteredSellList =
                                              _applyFilters(
                                                  sellInvoicesList ?? [],
                                                  false);
                                          if (filteredSellList.isEmpty) {
                                            return Center(
                                              child: Text(
                                                AppLocalizations.of(context)!
                                                    .noInvoicesFound,
                                                style: TextStyle(
                                                  fontSize: Adaptive.sp(16),
                                                  color: Colors.grey,
                                                ),
                                              ),
                                            );
                                          }
                                          return ListView.builder(
                                            padding: EdgeInsets.symmetric(
                                                horizontal: 12, vertical: 8),
                                            itemCount: filteredSellList.length,
                                            itemBuilder: (context, index) {
                                              final item =
                                                  filteredSellList[index];
                                              String dealId =
                                                  "${item.invoiceNumber ?? "N/A"}";
                                              String commodity =
                                                  "${item.commodity ?? "N/A"}";
                                              String district =
                                                  "${item.location ?? "N/A"}";
                                              String date = _formatDate(
                                                  "${item.date ?? "N/A"}");
                                              String price =
                                                  item.rate?.toString() ?? '';
                                              String quantity =
                                                  item.qty?.toString() ?? '';
                                              String warehouse =
                                                  "${item.location ?? ''}";
                                              String name =
                                                  "${item.buyerSellerName ?? ''}";
                                              String flag =
                                                  "${item.dealType ?? "N/A"}";

                                              return Card(
                                                color: Colors.white,
                                                margin: EdgeInsets.symmetric(
                                                    vertical: 6, horizontal: 2),
                                                elevation: 5,
                                                shape: RoundedRectangleBorder(
                                                  side: BorderSide(
                                                      color: ColorConstant
                                                          .maingreen),
                                                  borderRadius:
                                                      BorderRadius.circular(12),
                                                ),
