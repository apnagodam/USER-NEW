  List<SbtContractDatum> _sortSbtListByDate(List<SbtContractDatum>? list) {
    if (list == null) return [];
    list.sort((a, b) {
      final aDateStr = a.createdAt?.toString() ?? '';
      final bDateStr = b.createdAt?.toString() ?? '';
      final aDate = DateTime.tryParse(aDateStr);
      final bDate = DateTime.tryParse(bDateStr);
      return (bDate ?? DateTime(2000)).compareTo(aDate ?? DateTime(2000));
    });
    return list;
  }

  List<InventoryDatum> _sortWarehouseListByDate(List<InventoryDatum>? list) {
    if (list == null) return [];
    list.sort((a, b) {
      final aDateStr = a.createdAt?.toString() ?? '';
      final bDateStr = b.createdAt?.toString() ?? '';
      final aDate = DateTime.tryParse(aDateStr);
      final bDate = DateTime.tryParse(bDateStr);
      return (bDate ?? DateTime(2000)).compareTo(aDate ?? DateTime(2000));
    });
    return list;
  }

  List<dynamic> _sortStackBuyListByDate(List<dynamic>? list) {
    if (list == null) return [];
    list.sort((a, b) {
      final aDateStr = (a['createdAt'] ?? a['date'] ?? '').toString();
      final bDateStr = (b['createdAt'] ?? b['date'] ?? '').toString();
      final aDate = DateTime.tryParse(aDateStr);
      final bDate = DateTime.tryParse(bDateStr);
      return (bDate ?? DateTime(2000)).compareTo(aDate ?? DateTime(2000));
    });
    return list;
  }

  String _formatDate(String dateStr) {
    try {
      final date = DateTime.tryParse(dateStr);
      if (date == null) return dateStr;
      return "${date.day.toString().padLeft(2, '0')}/${date.month.toString().padLeft(2, '0')}/${date.year}";
    } catch (_) {
      return dateStr;
    }
  }

  // Helper to get all commodity types from the lists
  List<String> _getAllCommodityTypes() {
    final Set<String> commodities = {};
    for (var item in buyInvoicesList ?? []) {
      if (item.commodity != null && item.commodity!.isNotEmpty) {
        commodities.add(item.commodity!);
      }
    }
    return ["All", ...commodities];
  }

  // Helper to get all deal types from the lists
  List<String> _getAllDealTypes(List<InvoicesDatum> list) {
    final Set<String> dealTypes = {};
    for (var item in list) {
      if (item.dealType != null && item.dealType!.isNotEmpty) {
        dealTypes.add(item.dealType!);
      }
    }
    return ["All", ...dealTypes];
  }

  // Filtering logic
  List<InvoicesDatum> _applyFilters(List<InvoicesDatum> list, bool isBuyTab) {
    DateTime? startDate = isBuyTab ? _buyStartDate : _sellStartDate;
    DateTime? endDate = isBuyTab ? _buyEndDate : _sellEndDate;
    String? selectedType = isBuyTab ? _buySelectedType : _sellSelectedType;
    String? selectedCommodity =
        isBuyTab ? _buySelectedCommodity : _sellSelectedCommodity;

    return list.where((item) {
      // Date filter (range)
      if (startDate != null && endDate != null) {
        String dateStr = item.date ?? '';
        // Parse DD-MM-YYYY format
        DateTime? itemDate;
        try {
          final parts = dateStr.split('-');
          if (parts.length == 3) {
            final day = int.tryParse(parts[0]);
            final month = int.tryParse(parts[1]);
            final year = int.tryParse(parts[2]);
            if (day != null && month != null && year != null) {
              itemDate = DateTime(year, month, day);
            }
          }
        } catch (e) {
          debugPrint('Error parsing date: $dateStr, error: $e');
        }

        if (itemDate == null ||
            itemDate.isBefore(startDate) ||
            itemDate.isAfter(endDate)) {
          return false;
        }
      }
      // Type filter
      if (selectedType != null && selectedType != "All") {
        String flag = item.dealType ?? '';
        if (flag != selectedType) return false;
      }
      // Commodity filter
      if (selectedCommodity != null && selectedCommodity != "All") {
        String commodity = item.commodity ?? '';
        if (commodity != selectedCommodity) return false;
      }
      return true;
    }).toList();
  }

  Future<void> _handleDownload(BuildContext context, dynamic item,
      {bool isSell = false}) async {
    try {
      if (isSell) {
        final contractNote = await ref.watch(sellerContractNoteProvider(
                orderId: item.orderId.toString(), type: "Seller")
            .future);

        final file = await sellerContractPdf(contractNote, ref);
        if (file != null) {
          await FileSaver.instance
              .saveAs(
                  name: 'seller_sbt_contract_note',
                  file: file,
                  mimeType: MimeType.pdf,
                  ext: '.pdf')
              .then((value) {
            OpenFile.open(value);
          });

          Fluttertoast.showToast(
            msg: 'File saved successfully!',
            toastLength: Toast.LENGTH_LONG,
            backgroundColor: ColorConstant.maingreen,
          );

          final doc = await PDFDocument.fromFile(file);

          Get.bottomSheet(
            Stack(
              children: [
                PDFViewer(document: doc),
                Padding(
                  padding: EdgeInsets.all(10),
                  child: Align(
                    alignment: Alignment.bottomCenter,
                    child: ElevatedButton(
                      style: AppStyle.buttonStyle,
                      onPressed: () {},
                      child: Text(
                        'Download',
                        style: TextStyle(
                          fontSize: Adaptive.sp(16),
                          color: Colors.white,
                        ),
                      ),
                    ),
                  ),
                ),
              ],
            ),
            isScrollControlled: true,
          );
        }
      } else {
        final contractNote = await ref.watch(buyerContractNoteProvider(
                orderId: item.orderId.toString(), type: "Buyer")
            .future);

        final file = await settlementPdf(contractNote, "222", "2222", ref);
        if (file != null) {
          await FileSaver.instance
              .saveAs(
                  name: 'buyer_sbt_contract_note',
                  file: file,
                  mimeType: MimeType.pdf,
                  ext: '.pdf')
              .then((value) {
            OpenFile.open(value);
          });

          Fluttertoast.showToast(
            msg: 'File saved successfully!',
            toastLength: Toast.LENGTH_LONG,
            backgroundColor: ColorConstant.maingreen,
          );

          final doc = await PDFDocument.fromFile(file);

          Get.bottomSheet(
            Stack(
              children: [
                PDFViewer(document: doc),
                Padding(
                  padding: Pad(all: 10),
                  child: Align(
                    alignment: Alignment.bottomCenter,
                    child: ElevatedButton(
                      style: AppStyle.buttonStyle,
                      onPressed: () {},
                      child: Text(
                        'Download',
                        style: TextStyle(
                          fontSize: Adaptive.sp(16),
                          color: Colors.white,
                        ),
                      ),
                    ),
                  ),
                ),
              ],
            ),
            isScrollControlled: true,
          );
        }
      }
    } catch (e) {
      debugPrint(e.toString());
    }
  }

  void _showContractNoteStack(
      BuildContext context, String? dealId, String buySellType) {
    if (dealId == null) return;

    ref.read(stackContractNoteProvider(id: dealId).future).then((value) async {
      if (buySellType == "buy") {
        stackContractNotePdf(value, ref, buySellType).then((file) async {
          await FileSaver.instance
              .saveAs(
                  name: 'buyer_stack_contract_note',
                  file: file,
                  mimeType: MimeType.pdf,
                  ext: '.pdf')
              .then((value) {});
          Fluttertoast.showToast(
            msg: 'File saved successfully!',
            toastLength: Toast.LENGTH_LONG,
            backgroundColor: ColorConstant.maingreen,
          );

          OpenFile.open(file?.path);
        });
      } else {
        stackContractNotePdfSeller(value, ref, buySellType).then((file) async {
          await FileSaver.instance
              .saveAs(
                  name: 'seller_stack_contract_note',
                  file: file,
                  mimeType: MimeType.pdf,
                  ext: '.pdf')
              .then((value) {
            // OpenFile.open(value);
          });
          Fluttertoast.showToast(
            msg: 'File saved successfully!',
            toastLength: Toast.LENGTH_LONG,
            backgroundColor: ColorConstant.maingreen,
          );
          OpenFile.open(file?.path);
        });
      }
    });
  }

  // Add this method for Gatepass contract notes
  void _showContractNote(BuildContext context, String? dealId) {
    if (dealId == null) return;

    ref.read(contractNotesProvider(dealId: dealId).future).then((value) {
      GlobalBottomSheet.show(
        context,
        content: Text(AppLocalizations.of(context)!.yourBottomSheetContent),
        contractNote: value,
        callback: (dynamic result) {
          if (result == true) Get.back();
        },
      );
    });
  }

  @override
  void initState() {
    super.initState();

    WidgetsBinding.instance.addPostFrameCallback((_) async {
      ref.watch(isLoadingProvider.notifier).state = true;
      debugPrint('Fetching invoices...');

      try {
        // Fetch both invoice lists in parallel
        final results = await Future.wait([
          ref.watch(getInvoicesProvider(type: 'sell').future),
          ref.watch(getInvoicesProvider(type: 'buy').future),
        ]);

        // Update sell invoices (Invoices Raised By Me)
        if (results[0].data != null) {
          sellInvoicesList = results[0].data ?? [];
        }

        // Update buy invoices (Invoices Raised To Me)
        if (results[1].data != null) {
          buyInvoicesList = results[1].data ?? [];
        }

        setState(() {});
      } catch (e) {
        debugPrint('Error fetching invoices: $e');
      } finally {
        ref.watch(isLoadingProvider.notifier).state = false;
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final tabIndex = ref.watch(selectedTabIndex);
    final isBuyTab = tabIndex == 0;

    debugPrint('Build called - isBuyTab: $isBuyTab');
    debugPrint('buyInvoicesList length: ${buyInvoicesList?.length ?? 0}');
    debugPrint('sellInvoicesList length: ${sellInvoicesList?.length ?? 0}');

    // Get commodity types for the current tab
    final commodityTypesList = isBuyTab
        ? _getAllCommodityTypes()
        : (() {
            final Set<String> commodities = {};
            for (var item in sellInvoicesList ?? []) {
              if (item.commodity != null && item.commodity!.isNotEmpty) {
                commodities.add(item.commodity!);
              }
            }
            return ["All", ...commodities];
          })();

    _commodityTypes = commodityTypesList;

    // Get deal types for the current tab
    _dealTypes = _getAllDealTypes(
        isBuyTab ? (buyInvoicesList ?? []) : (sellInvoicesList ?? []));

    final filteredList = _applyFilters(
        isBuyTab ? (buyInvoicesList ?? []) : (sellInvoicesList ?? []),
        isBuyTab);

    debugPrint('Filtered list length: ${filteredList.length}');

    return Scaffold(
      appBar: AppBar(
