                                                            style: TextStyle(
                                                              fontWeight:
                                                                  FontWeight
                                                                      .w600,
                                                              fontSize:
                                                                  Adaptive.sp(
                                                                      16),
                                                              color: Colors
                                                                  .grey[700],
                                                            ),
                                                          ),
                                                          Expanded(
                                                            child: Text(
                                                              dealId,
                                                              style: TextStyle(
                                                                fontSize:
                                                                    Adaptive.sp(
                                                                        16),
                                                                color: Colors
                                                                    .black87,
                                                              ),
                                                              overflow:
                                                                  TextOverflow
                                                                      .ellipsis,
