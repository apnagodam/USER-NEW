                                  data == AuthStatus.loggedOut
                                      ? Center(
                                          child: Container(
                                            padding: EdgeInsets.symmetric(
                                                horizontal: 24, vertical: 32),
                                            decoration: BoxDecoration(
                                              color: Colors.white,
                                              borderRadius:
