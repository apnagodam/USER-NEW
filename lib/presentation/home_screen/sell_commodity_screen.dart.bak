                                                          ));
                                                    } else {
                                                      Get.to(() => Lplistscreen(
                                                            lat: position
                                                                .latitude
                                                                .toString(),
                                                            long: position
                                                                .longitude
                                                                .toString(),
                                                            commoditId: widget
                                                                .commodityid
                                                                .toString(),
                                                            quantity: cont
                                                                .ownquantitycontroller
                                                                .text
                                                                .toString(),
                                                            dealType: "MGP",
                                                            salesStatus:
