                                                                data:
                                                                    encodedJson,
                                                                version:
                                                                    QrVersions
                                                                        .auto,
                                                                size: 200.0,
                                                                gapless: false,
                                                              ),
                                                            ),
                                                          );
                                                        });
                                                  } else {}
                                                },
