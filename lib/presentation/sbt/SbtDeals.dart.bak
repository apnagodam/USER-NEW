class Sbtdeals extends ConsumerStatefulWidget {
  Sbtdeals({super.key, this.selectedIndex, this.sbtOrderId});
  int? selectedIndex = 1;
  String? sbtOrderId = "";
  @override
  ConsumerState<Sbtdeals> createState() => _SbtdealsState();
}

class _SbtdealsState extends ConsumerState<Sbtdeals> {
  var selectedTabIndex = StateProvider((ref) => 0);
  ScrollController pageController = ScrollController();
  ScrollController pageController2 = ScrollController();
  late ListObserverController observerController;
  late ListObserverController observerController2;
  final buyOrdersListProvider = StateProvider((ref) => <MatchedOrdersDatum>[]);
  final sellOrdersListProvider = StateProvider((ref) => <MatchedOrdersDatum>[]);
  @override
  void initState() {
    super.initState();
    observerController = ListObserverController(controller: pageController);
    observerController2 = ListObserverController(controller: pageController2);
    WidgetsBinding.instance.addPostFrameCallback((_) async {
      ref.watch(selectedTabIndex.notifier).state = widget.selectedIndex ?? 0;
      final value = await ref.watch(matchedOrdersProvider.future);
      final buyOrders = value.data
              ?.where(
                  (element) => element.type.toString().toLowerCase() == "buy")
              .toList() ??
          [];
      ref.watch(buyOrdersListProvider.notifier).state = buyOrders;

      final sellerOrders = value.data
              ?.where(
                  (element) => element.type.toString().toLowerCase() == "sell")
              .toList() ??
          [];
      ref.watch(sellOrdersListProvider.notifier).state = sellerOrders;

      if (widget.selectedIndex == 1) {
        // Find the index after the provider is updated
        final sbtIndex = buyOrders.indexWhere(
            (element) => element.orderId.toString() == widget.sbtOrderId);

        // Wait for the next frame to ensure the list is built
        if (sbtIndex != -1) {
          Future.delayed(Duration(milliseconds: 300), () {
            observerController.animateTo(
              index: sbtIndex,
              duration: Duration(seconds: 1),
              curve: Curves.ease,
            );
          });
        }
      } else {
        // Find the index after the provider is updated
        final sbtIndex = sellerOrders.indexWhere(
            (element) => element.orderId.toString() == widget.sbtOrderId);

        // Wait for the next frame to ensure the list is built
        if (sbtIndex != -1) {
          Future.delayed(Duration(milliseconds: 300), () {
            observerController2.animateTo(
              index: sbtIndex,
              duration: Duration(seconds: 1),
              curve: Curves.ease,
            );
          });
        }
      }
    });
  }

  var tabIndexProvider = StateProvider<int>((ref) => 0);

  List<Map<String, dynamic>> get tabs => [
        {
          "label": AppLocalizations.of(context)!.sold,
          "index": 0,
          "icon": Icons.layers
        },
        {
          "label": AppLocalizations.of(context)!.purchased,
          "index": 1,
          "icon": Icons.receipt_long
        },
      ];
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(AppLocalizations.of(context)!.deliveryMarking),
      ),
      body: DeliveryMarking(
        isScreen: false,
      ),
    );
  }
}

class DeliveryMarking extends ConsumerStatefulWidget {
  const DeliveryMarking({super.key, required this.isScreen});
  final bool isScreen;
  @override
  ConsumerState<DeliveryMarking> createState() => _DeliveryMarkingState();
}

class _DeliveryMarkingState extends ConsumerState<DeliveryMarking> {
  var tabIndexProvider = StateProvider<int>((ref) => 0);

  List<Map<String, dynamic>> get tabs => [
        {
          "label": AppLocalizations.of(context)!.sold,
          "index": 0,
          "icon": Icons.layers
        },
        {
          "label": AppLocalizations.of(context)!.purchased,
          "index": 1,
          "icon": Icons.receipt_long
        },
      ];
  var selectedTabIndex = StateProvider((ref) => 0);
  ScrollController pageController = ScrollController();
  ScrollController pageController2 = ScrollController();
  late ListObserverController observerController;
  late ListObserverController observerController2;
