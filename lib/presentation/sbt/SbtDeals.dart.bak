  final sellOrdersListProvider = StateProvider((ref) => <MatchedOrdersDatum>[]);
  @override
  void initState() {
    super.initState();
    observerController = ListObserverController(controller: pageController);
    observerController2 = ListObserverController(controller: pageController2);
    WidgetsBinding.instance.addPostFrameCallback((_) async {
      final value = await ref.watch(matchedOrdersProvider.future);
      final buyOrders = value.data
              ?.where(
                  (element) => element.type.toString().toLowerCase() == "buy")
              .toList() ??
          [];
      ref.watch(buyOrdersListProvider.notifier).state = buyOrders;

      final sellerOrders = value.data
              ?.where(
                  (element) => element.type.toString().toLowerCase() == "sell")
              .toList() ??
          [];
      ref.watch(sellOrdersListProvider.notifier).state = sellerOrders;
    });
