                final tab = tabs[i];
                final isSelected = ref.watch(tabIndexProvider) == tab['index'];

                return InkWell(
                  onTap: () {
                    ref.watch(tabIndexProvider.notifier).state =
                        int.parse(tab['index'].toString());
