                                                                  .maingreen,
                                                          padding: Pad(
                                                              left: 10,
                                                              right: 10),
                                                          decoration:
                                                              InputDecoration(
                                                            contentPadding: Pad(
                                                                left: 10,
                                                                right: 10),
                                                            focusedErrorBorder: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
                                                            disabledBorder: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
                                                            errorBorder: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
                                                            focusedBorder: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
                                                            border: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
                                                            enabledBorder: OutlineInputBorder(
                                                                borderSide: BorderSide(
                                                                    style: BorderStyle
                                                                        .solid,
                                                                    color: ColorConstant
                                                                        .maingreen)),
