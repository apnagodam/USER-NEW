                                                        tripIdProvider.notifier)
                                                    .state = data,
                                            decoratorProps:
                                                DropDownDecoratorProps(
                                              decoration: InputDecoration(
                                                  contentPadding: Pad(
                                                      left: 10,
                                                      bottom: 5,
                                                      top: 5),
                                                  hintText: AppLocalizations.of(
                                                          context)!
                                                      .selectTripId,
                                                  border: OutlineInputBorder(
                                                      borderRadius:
                                                          BorderRadius.all(
                                                              Radius.circular(
                                                                  8)),
                                                      borderSide: BorderSide(
                                                          color: ColorConstant
                                                              .maingreen))),
                                            ),
                                          ),
                                        ),
                                    error: (e, s) => Container(),
                                    loading: () =>
                                        CupertinoActivityIndicator()),
                        SizedBox(
                          height: 10,
                        ),
                        InkWell(
                          onTap: () {
                            if (ref.watch(terminalsProvider) == null) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!
                                      .selectYourTerminal,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else if (ref.watch(commodityProvider) == null) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!
                                      .selectYourCommodity,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else if (weaightcontroller.text.isEmpty) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!
                                      .selectYourWeight,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else if (ref.watch(transportTypeProvider) ==
                                    TransporterType.own &&
                                vehiclenocontroller.text.isEmpty) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!
                                      .selectYourVehicle,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            }
                            // else if (ref.watch(vehicleTypeProvider) ==
                            //     VehicleType.Default) {
                            //   Get.rawSnackbar(
                            //       message: AppLocalizations.of(context)!.selectYourVehicleType,
                            //       duration:  Duration(seconds: 2),
                            //       backgroundColor: ColorConstant.red500);
                            // }

                            else if (ref.watch(transportTypeProvider) ==
                                    TransporterType.own &&
                                driverNoController.text.isEmpty) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!
                                      .selectYourDriver,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else if (ref.watch(transportTypeProvider) ==
                                    TransporterType.company &&
                                ref.watch(tripIdProvider) == null) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!.pleaseSelectTripId3,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else if (ref.watch(transportTypeProvider) ==
                                    TransporterType.own &&
                                ref.watch(autoInvoiceProvider) == null) {
                              Get.rawSnackbar(
                                  message: AppLocalizations.of(context)!.pleaseSelectAutoInvoice2,
                                  duration: Duration(seconds: 2),
                                  backgroundColor: ColorConstant.red500);
                            } else {
                              ref
                                  .watch(terminalStackDataProvider(
                                terminalId: ref
                                        .watch(terminalsProvider)
                                        ?.warehouseId
                                        .toString() ??
                                    "0",
                                commodityId: ref
                                    .watch(commodityProvider)
                                    ?.commodity
                                    .toString(),
                                weightReq: weaightcontroller.text,
                                stackType: "",
                                inOutStatus: "OUT",
                                driverNumber: driverNoController.text,
                                vehicleNo: vehiclenocontroller.text,
                              ).future)
                                  .then((value) {
                                if ((value.data ?? []).isEmpty) {
                                  CommanDialog(
                                      context,
                                      AppLocalizations.of(context)!.msgAlert,
                                      AppLocalizations.of(context)!.validationOutwordStack2,
                                      (userClickedOK) {
                                    if (userClickedOK) {
                                      print("object");
                                      Navigator.of(context, rootNavigator: true)
                                          .pop();

                                      Get.off(() => RepaymentScreen());
                                    } else {
                                      Navigator.of(context, rootNavigator: true)
                                          .pop();
                                    }
                                  });
                                } else {
                                  showModalBottomSheet(
                                    context: context,
                                    isScrollControlled: true,
                                    builder: (bottomsheetContext) {
                                      return ElevarmBottomSheet(
                                          title: AppLocalizations.of(context)!
                                              .msgWarehousefacility,
                                          initialChildSize: 1,
                                          minChildSize: 1,
                                          onPressedClose: () {
                                            Navigator.of(bottomsheetContext,
                                                    rootNavigator: false)
                                                .pop();
                                          },
                                          children: [
                                            SizedBox(
                                              child: Column(
                                                // mainAxisAlignment: MainAxisAlignment.center,
                                                crossAxisAlignment:
                                                    CrossAxisAlignment.center,
                                                children: [
                                                  Padding(
                                                    padding:
                                                        EdgeInsets.all(4.0),
                                                    child: SizedBox(
                                                      child: GridView.count(
                                                        physics:
                                                            NeverScrollableScrollPhysics(),
                                                        shrinkWrap: true,
                                                        crossAxisSpacing: 5,
                                                        mainAxisSpacing: 10,
                                                        crossAxisCount: 3,
                                                        children: List.generate(
                                                            value.data
                                                                    ?.length ??
                                                                0, (index) {
                                                          var occupied = value
                                                                  .data?[index]
                                                                  .stackTotalInv ??
                                                              0 -
                                                                  (value.data?[index]
                                                                          .stackReleaseInv ??
                                                                      0);
                                                          return SizedBox(
                                                            width: Get.width,
                                                            child: Column(
                                                              children: [
                                                                Row(
                                                                  mainAxisAlignment:
                                                                      MainAxisAlignment
                                                                          .center,
                                                                  children: [
                                                                    Text(
                                                                      AppLocalizations.of(context)!.msgStackno3,
                                                                      style: TextStyle(
                                                                          fontSize: Adaptive.sp(
                                                                              13),
                                                                          fontWeight:
                                                                              FontWeight.w700),
                                                                    ),
                                                                    Text(
                                                                      '${value.data?[index].stackNumber}',
                                                                      style: TextStyle(
                                                                          fontSize: Adaptive.sp(
                                                                              13),
                                                                          fontWeight:
                                                                              FontWeight.w700),
                                                                    ),
                                                                  ],
                                                                ),
                                                                InkWell(
                                                                    onTap:
                                                                        () async {
                                                                      await ref
                                                                          .watch(createStackRequestOutwardsProvider(stackType: value.data?[index].stackType, requestWeight: weaightcontroller.text, inOutStatus: "OUT", stackNum: value.data?[index].stackNumber.toString(), stackRowId: value.data?[index].id.toString(), commodityId: ref.watch(commodityProvider)?.commodity.toString(), vhicalNo: vehiclenocontroller.text.toString(), lockInMonth: '', warehouseRent: '', driverNumber: driverNoController.text.toString(), releaseInv: "${value.data?[index].stackReleaseBags}", releaseBags: "${value.data?[index].stackReleaseInv}", transporterType: ref.watch(transportTypeProvider) == TransporterType.own ? "1" : "2", tripId: "${ref.watch(tripIdProvider)?.id}", autoInvoicing: ref.watch(autoInvoiceProvider)?.type.toString(), poIds: ref.watch(purchaseOrderProvider)?.id.toString() ?? "")
                                                                              .future)
                                                                          .then(
                                                                              (value) async {
                                                                        if (value['status'].toString() ==
                                                                            "1") {
                                                                          // Close bottom sheet
                                                                          Navigator.of(bottomsheetContext, rootNavigator: false)
                                                                              .pop();

                                                                          // Reset form data
                                                                          resetFormData();

                                                                          // Navigate to outwards list
                                                                          Get.off(() =>
                                                                              Outwardslist());
                                                                        }
                                                                        Fluttertoast.showToast(
                                                                            msg:
                                                                                value['message'].toString());
                                                                      }).onError((e,
                                                                              s) {
                                                                        errorBottomSheet(
                                                                            context,
                                                                            e.toString());
                                                                      });
                                                                    },
                                                                    child:
                                                                        Container(
                                                                      width: Get
                                                                          .width,
                                                                      decoration: BoxDecoration(
                                                                          color: Colors.green.withOpacity(
                                                                              0.3),
                                                                          border: Border.all(
                                                                              color: Colors.green,
                                                                              width: 3),
                                                                          borderRadius: BorderRadius.circular(8)),
                                                                      child:
                                                                          Padding(
                                                                        padding:
                                                                            EdgeInsets.all(5.0),
                                                                        child:
                                                                            Column(
                                                                          mainAxisAlignment:
                                                                              MainAxisAlignment.center,
                                                                          children: [
                                                                            Text.rich(TextSpan(
                                                                                text: AppLocalizations.of(context)!.releasedWeight2,
                                                                                style: TextStyle(
                                                                                  fontSize: Adaptive.sp(14),
                                                                                  fontWeight: FontWeight.w700,
                                                                                  fontFamily: 'Roboto',
                                                                                ),
                                                                                children: [])),
                                                                            SizedBox(
                                                                              height: 5,
                                                                            ),
                                                                            Text.rich(TextSpan(
                                                                                text: "${double.tryParse(value.data?[index].stackReleaseInv.toString() ?? "0.0")?.toStringAsFixed(2)} (Qtl.)",
                                                                                style: TextStyle(
                                                                                  fontSize: Adaptive.sp(14),
                                                                                  fontWeight: FontWeight.w700,
                                                                                  fontFamily: 'Roboto',
                                                                                ),
                                                                                children: [])),
                                                                            SizedBox(
                                                                              height: 5,
                                                                            ),
                                                                            Text.rich(TextSpan(
                                                                                text: AppLocalizations.of(context)!.releasedBags3,
                                                                                style: TextStyle(
                                                                                  fontSize: Adaptive.sp(14),
                                                                                  fontWeight: FontWeight.w700,
                                                                                  fontFamily: 'Roboto',
                                                                                ),
                                                                                children: [])),
                                                                            Text.rich(TextSpan(
                                                                                text: "${value.data![index].stackReleaseBags}",
                                                                                style: TextStyle(
                                                                                  fontSize: Adaptive.sp(14),
                                                                                  fontWeight: FontWeight.w700,
                                                                                  fontFamily: 'Roboto',
                                                                                ),
                                                                                children: [])),
                                                                          ],
                                                                        ),
                                                                      ),
                                                                    )),
                                                                SizedBox(
                                                                  height: 5,
                                                                ),
                                                              ],
                                                            ),
                                                          );
                                                        }),
                                                      ),
                                                    ),
                                                  ),
                                                ],
                                              ),
                                            )
                                          ]);
                                    },
                                  );
                                }
                              }).onError((e, s) {
                                errorBottomSheet(context, e.toString());
                              });
                            }
                          },
                          child: Container(
                            height: 46,
                            width: double.infinity,
                            decoration: BoxDecoration(
                                color: ColorConstant.maingreen,
                                borderRadius:
                                    BorderRadius.all(Radius.circular(6))),
                            child: Center(
                                child: Text(
                              AppLocalizations.of(context)!.msgSubmit,
                              style: TextStyle(color: Colors.white),
                            )),
                          ),
                        ),
                      ],
                    ),
                  ),
              error: (e, s) => noStockData(context),
              loading: () => defaultLoader())
        ],
      ),
    );
  }
}
