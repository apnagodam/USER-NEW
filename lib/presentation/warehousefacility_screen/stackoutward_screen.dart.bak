class StackOutward extends ConsumerStatefulWidget {
  StackOutward({super.key, this.isAppBarVisible});
  bool? isAppBarVisible = false;
  @override
  ConsumerState<StackOutward> createState() => _StackOutwardState();
}

class _StackOutwardState extends ConsumerState<StackOutward> {
  @override
  void initState() {
    super.initState();
  }

  var terminalsProvider = StateProvider<Datum?>((ref) => null);

  var commodityProvider = StateProvider<Datum?>((ref) => null);

  var commodityList = StateProvider<List<Datum>>((ref) => []);
  var stackWiseList = StateProvider((ref) => []);
  var stackList = StateProvider<List<Datum>>((ref) => []);
  var totalPayableAmountProvider = StateProvider((ref) => 0.00);
  var warehouseIdProvider = StateProvider((ref) => '0');
  var commodityIdProvider = StateProvider((ref) => '0');
  var weaightcontroller = TextEditingController();
  var vehiclenocontroller = TextEditingController();
  var searchcontroller = TextEditingController();
  var driverNoController = TextEditingController();
  var transportTypeProvider =
      StateProvider((ref) => TransporterType.defaultType);

  var autoInvoiceProvider = StateProvider<AutoInvoiceType?>((ref) => null);
  var tripIdProvider = StateProvider<tripData.Datum?>((ref) => null);
  final tabs = [
    {"label": AppLocalizations.of(context)!.outwardRequest3, "index": 0, "icon": Icons.warehouse},
    {"label": AppLocalizations.of(context)!.history2, "index": 1, "icon": Icons.qr_code_2},
  ];
  var selectedTabIndex = StateProvider((ref) => 0);
  final purchaseOrderProvider =
      StateProvider<PurchaseOrderDatum?>((ref) => null);

  // Method to reset all form data
  void resetFormData() {
    // Reset all text controllers
    weaightcontroller.clear();
    vehiclenocontroller.clear();
    searchcontroller.clear();
    driverNoController.clear();

    // Reset all state providers
    ref.read(terminalsProvider.notifier).state = null;
    ref.read(commodityProvider.notifier).state = null;
    ref.read(commodityList.notifier).state = [];
    ref.read(stackWiseList.notifier).state = [];
    ref.read(stackList.notifier).state = [];
    ref.read(totalPayableAmountProvider.notifier).state = 0.00;
    ref.read(warehouseIdProvider.notifier).state = '0';
    ref.read(commodityIdProvider.notifier).state = '0';
    ref.read(transportTypeProvider.notifier).state =
        TransporterType.defaultType;
    ref.read(autoInvoiceProvider.notifier).state = null;
    ref.read(tripIdProvider.notifier).state = null;
    ref.read(selectedTabIndex.notifier).state = 0;
    ref.read(purchaseOrderProvider.notifier).state = null;

    // Invalidate related providers to refresh data
    ref.invalidate(commodityList);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: widget.isAppBarVisible == true
          ? AppBar(
              title: Text(AppLocalizations.of(context)!.outwards3),
              flexibleSpace: Container(
                decoration: BoxDecoration(
                    gradient: LinearGradient(
                        begin: Alignment.topLeft,
                        end: Alignment.bottomRight,
                        colors: <Color>[
                      Color(0xFF12281B), // Deep green-black
                      Color(0xFF275135), // Your main green
                      Color(0xFF3E7251),
                    ])),
              ),
              centerTitle: true,
            )
          : null,
      floatingActionButton: simpleButton(
          text: AppLocalizations.of(context)!.history2,
          callback: () {
            Get.to(Outwardslist());
          }),
      body: ListView(
        children: [
          ref.watch(repaymentTerminalsProvider()).when(
              data: (data) => Padding(
                    padding: EdgeInsets.all(8.0),
                    child: Column(
                      children: [
                        Container(
                          decoration: BoxDecoration(
                              borderRadius:
                                  BorderRadius.all(Radius.circular(8)),
                              border: Border.all()),
                          child: DropdownButtonHideUnderline(
                            child: DropdownButton<Datum>(
                              isExpanded: true,
                              value: ref.watch(terminalsProvider),
                              icon: Icon(Icons.keyboard_arrow_down),
                              hint: Center(
                                  child: Text(AppLocalizations.of(context)!
                                      .msgTerminalname)),
                              items: List.generate(
                                  data.data?.length ?? 0,
                                  (index) => DropdownMenuItem(
                                        alignment: AlignmentDirectional.center,
                                        value: data.data?[index],
                                        child: Padding(
                                          padding: EdgeInsets.symmetric(
                                              horizontal: 10),
                                          child: Row(
                                            children: [
                                              Radio(
                                                value: data.data?[index],
                                                groupValue: ref
                                                    .watch(terminalsProvider),
                                                onChanged: (value) {
                                                  ref
                                                      .watch(terminalsProvider
                                                          .notifier)
                                                      .state = value!;
                                                },
                                                activeColor:
                                                    ColorConstant.maingreen,
                                              ),
                                              Expanded(
                                                  child: Text(
                                                '${data.data?[index].warehouseName}',
                                                overflow: TextOverflow.ellipsis,
                                              ))
                                            ],
                                          ),
                                        ),
                                      )),
                              onChanged: (val) {
                                ref.watch(terminalsProvider.notifier).state =
                                    val;
                                ref.invalidate(commodityList);
                              },
                            ),
                          ),
                        ),
                        SizedBox(
                          height: 20,
                        ),
                        ref.watch(terminalsProvider) == null
                            ? SizedBox()
                            : ref
                                .watch(repaymentTerminalsProvider(
                                    terminalId: ref
                                        .watch(terminalsProvider)
                                        ?.warehouseId
                                        .toString(),
                                    commodityId:
                                        "${ref.watch(terminalsProvider)?.commodity}",
                                    type: "commodity"))
                                .when(
                                    data: (commodities) => Container(
                                          decoration: BoxDecoration(
                                              borderRadius: BorderRadius.all(
                                                  Radius.circular(8)),
                                              border: Border.all()),
                                          height: 50,
                                          child: DropdownButtonHideUnderline(
                                            child: DropdownButton<Datum>(
                                              isExpanded: true,
                                              value:
                                                  ref.watch(commodityProvider),
                                              icon: Icon(
                                                  Icons.keyboard_arrow_down),
                                              hint: Center(
                                                  child: Text(
                                                      AppLocalizations.of(
                                                              context)!
                                                          .msgCommodityy)),
                                              items: List.generate(
                                                  commodities.data?.length ?? 0,
                                                  (index) => DropdownMenuItem(
                                                        alignment:
                                                            AlignmentDirectional
                                                                .center,
                                                        value: commodities
                                                            .data?[index],
                                                        child: Padding(
                                                          padding: EdgeInsets
                                                              .symmetric(
                                                                  horizontal:
                                                                      10),
                                                          child: Row(
                                                            children: [
                                                              Radio(
                                                                value: commodities
                                                                        .data?[
                                                                    index],
                                                                groupValue:
                                                                    ref.watch(
                                                                        commodityProvider),
                                                                onChanged:
                                                                    (value) {
                                                                  ref
                                                                      .watch(commodityProvider
                                                                          .notifier)
                                                                      .state = value!;
                                                                },
                                                                activeColor:
                                                                    ColorConstant
                                                                        .maingreen,
                                                              ),
                                                              Expanded(
                                                                  child: Text(
                                                                '${commodities.data?[index].category}',
                                                                overflow:
                                                                    TextOverflow
                                                                        .ellipsis,
                                                              ))
                                                            ],
                                                          ),
                                                        ),
                                                      )),
                                              onChanged: (val) {
                                                ref
                                                    .watch(commodityProvider
                                                        .notifier)
                                                    .state = val;
                                              },
                                            ),
                                          ),
                                        ),
                                    error: (e, s) => Container(),
                                    loading: () => Container()),
                        ref.watch(commodityProvider) == null
                            ? SizedBox()
                            : Padding(
                                padding:
                                    EdgeInsets.only(bottom: 15.0, top: 15.0),
                                child: CommonTextField(
                                  controller: weaightcontroller,
                                  label: AppLocalizations.of(context)!
                                      .msgWeightwithqtl,
                                  textInputAction: TextInputAction.next,
                                  inputType: TextInputType.numberWithOptions(
                                      decimal: true),
                                  enabled: true,
                                  maxLength: 10,
                                  isRequired: true,
                                ),
                              ),
                        if (ref.watch(commodityProvider) != null)
                          titleWidget(
                              text: AppLocalizations.of(context)!
                                  .msgTransportType),
