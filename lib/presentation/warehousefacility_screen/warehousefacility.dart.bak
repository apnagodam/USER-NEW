                                    alignment: Alignment.centerLeft,
                                    children: [
                                      Padding(
                                        padding: Pad(all: 10),
                                        child: Text(
                                          "${terminal?.category}",
                                          style: TextStyle(
                                              fontWeight: FontWeight.w500,
                                              fontSize: Adaptive.sp(16)),
