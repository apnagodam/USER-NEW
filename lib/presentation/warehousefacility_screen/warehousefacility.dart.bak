                                          color: ColorConstant.maingreen)),
                                )),
                            menuProps: MenuProps(
                                shape: RoundedRectangleBorder(
                                    side: BorderSide(
                                        color: ColorConstant.maingreen),
                                    borderRadius: BorderRadius.circular(8))),
                            itemBuilder: (context, terminal, isVisibl, _) =>
                                ColumnSuper(
                                    alignment: Alignment.centerLeft,
                                    children: [
                                      Padding(
                                        padding: Pad(all: 10),
                                        child: Text(
                                          "$terminal",
                                          style: TextStyle(
                                              fontWeight: FontWeight.w500,
